package layout

import "fmt"

templ Base(s Settings, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="icon" href="/favicon.ico" type="image/x-icon"/>
			<link rel="stylesheet" href="/assets/css/style-catppuccin-frappe.css" media="not (prefers-color-scheme: light)"/>
			<link rel="stylesheet" href="/assets/css/style-catppuccin-latte.css" media="(prefers-color-scheme: light)"/>
			<link rel="stylesheet" href="/assets/css/code-catppuccin-frappe.css" media="not (prefers-color-scheme: light)"/>
			<link rel="stylesheet" href="/assets/css/code-catppuccin-latte.css" media="(prefers-color-scheme: light)"/>
			<title>{ s.SEO.SiteTitle }</title>
			@templ.Raw(schemaOrg(s))
			<meta name="description" content={ s.SEO.SiteDescription }/>
			<meta property="og:title" content={ s.SEO.SiteTitle }/>
			<meta property="og:description" content={ s.SEO.SiteDescription }/>
			<meta property="og:type" content="website"/>
			<meta property="og:url" content={ s.URL }/>
		</head>
		<body>
			<div id="wrapper">
				<header id="header">
					<h1>{ s.SiteName }</h1>
					<p>{ s.SubTitle }</p>
					@header(s.HeaderLinks)
				</header>
				<main id="content">
					@content
				</main>
				<footer id="footer">
					Copyright (c) 2015-2026 Bruno Jesus. Some Rights Reserved.
				</footer>
			</div>
		</body>
	</html>
}

func schemaOrg(s Settings) string {
	json := s.SEO.SchemaOrg.ToJSON()
	return fmt.Sprintf("<script type=\"application/ld+json\">%s</script>", json)
}
