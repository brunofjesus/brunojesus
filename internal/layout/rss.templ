package layout

import (
	"fmt"
	"time"
)

templ RSSFeed(s Settings, items []templ.Component) {
	@templ.Raw(`<?xml version="1.0" encoding="UTF-8" ?>`)
	<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/">
		<channel>
			<title>{ s.SiteName } </title>
			@templ.Raw(fmt.Sprintf("<link>%s</link>", templ.EscapeString("https://brunojesus.pt")))
			<description>{ s.SubTitle }</description>
      for _, item := range items {
        @item 
      }
		</channel>
	</rss>
}

templ RSSItem(title, path, content string, date time.Time) {
	<item>
		<title>{ title }</title>
		@templ.Raw(fmt.Sprintf("<link>%s</link>", templ.EscapeString(fmt.Sprintf("https://brunojesus.pt/%s", path))))
		@templ.Raw(fmt.Sprintf("<guid>%s</guid>", templ.EscapeString(fmt.Sprintf("https://brunojesus.pt/%s", path))))
		<pubDate>{ date.Format("Mon, 02 Jan 2006 15:04:05 MST") }</pubDate>
		<content:encoded>
			@templ.Raw(fmt.Sprintf("<![CDATA[%s]]>", content))
		</content:encoded>
	</item>
}
