package layout

import "time"

templ Page(title, content string, date *time.Time) {
	if len(title) > 0 && date != nil {
		<h1>@pageTitleLink(title) — { date.Format("02 January, 2006") }</h1>
	} else if len(title) > 0 {
		<h1>@pageTitleLink(title)</h1>
	}
	@templ.Raw(content)
}

templ pageTitleLink(title string) {
	<a href="#">{ title }</a>
}
